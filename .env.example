# Copy to .env for local dev (never commit .env). On Render, set these in the
# service's Environment tab instead.

# Public — safe to expose to the browser (served via /api/config)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GITHUB_CLIENT_ID=your-github-oauth-app-client-id

# Secret — server only, NEVER commit or expose to the browser
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
