# Copy to .env for local dev (never commit .env). On Render, set these in the
# service's Environment tab instead.

# Public — safe to expose to the browser (served via /api/config)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GITHUB_CLIENT_ID=your-github-oauth-app-client-id

# Secret — server only, NEVER commit or expose to the browser
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# ---- Dodo Payments ----
# "test" uses test.dodopayments.com, "live" uses live.dodopayments.com
DODO_PAYMENTS_ENV=live
# Secret — Dodo dashboard ▸ Developer ▸ API Keys
DODO_PAYMENTS_API_KEY=
# Secret — Dodo dashboard ▸ Developer ▸ Webhooks (starts with whsec_)
# Webhook URL to register: https://YOUR-DOMAIN/api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_SECRET=
# Product IDs (pdt_…) from Dodo dashboard ▸ Products
DODO_PRODUCT_CUTTING_MONTHLY=
DODO_PRODUCT_CUTTING_ANNUAL=
DODO_PRODUCT_KETTLE_MONTHLY=
DODO_PRODUCT_KETTLE_ANNUAL=
DODO_PRODUCT_KADAK=
# Optional — your public site URL, used for the after-checkout redirect
PUBLIC_URL=

# ---- Sessions + referrals ----
# Secret — any long random string (keeps people signed in across restarts)
SESSION_SECRET=
# Dodo discount code given to referred friends (created in Dodo: 20% off first payment)
REFERRAL_DISCOUNT_CODE=CAFEFRIEND20

# ---- Admin + database ----
# Comma-separated emails that can open /admin (they sign in with Google/GitHub)
ADMIN_EMAILS=meetjethwa3@gmail.com
# Secret — the café's own Postgres login (create it with: node scripts/setup-db.js "<owner URL>")
# Leave empty locally to use data/store.json instead.
DATABASE_URL=
